{
  "name": "krishisahyog-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/build-production.mjs",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "clean": "node -e \"for (const p of ['dist','server.js']) require('fs').rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx server/db/migrate.ts",
    "ingest:once": "tsx server/ingestion/worker.ts",
    "test:ingestion": "node --experimental-strip-types --test tests/phase3_secureFetch.test.mjs",
    "test:extraction": "node --experimental-strip-types --test tests/phase4_extraction.test.mjs",
    "pilot:preflight": "tsx server/ingestion/pilotPreflight.ts",
    "test:pilot": "node --experimental-strip-types --test tests/phase11_pilotReadiness.test.mjs",
    "pilot:diagnose": "node scripts/diagnose.mjs",
    "source:register": "tsx scripts/register-source.ts",
    "content:workflow": "tsx scripts/content-workflow.ts",
    "research:import": "tsx scripts/import-research.ts",
    "research:check": "tsx scripts/import-research.ts --dry-run",
    "test:research": "node --experimental-strip-types --test tests/research_integration.test.mjs",
    "research:to-draft": "tsx scripts/research-to-draft.ts",
    "test:phase12": "node --experimental-strip-types --test tests/phase12_hackathon.test.mjs",
    "test:all": "node --experimental-strip-types --test tests/*.test.mjs",
    "hackathon:preflight": "tsx scripts/hackathon-preflight.ts",
    "test:phase13": "node --experimental-strip-types --test tests/phase13_workflow.test.mjs",
    "phase13:preflight": "node scripts/phase13-preflight.mjs",
    "build:verify": "node scripts/verify-production-bundle.mjs dist",
    "dev:local": "vite --port=3000 --host=127.0.0.1",
    "test:phase14": "node --experimental-strip-types --test tests/phase14_release.test.mjs",
    "phase14:gate": "node scripts/phase14-release-gate.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/pg": "^8.11.10"
  }
}
