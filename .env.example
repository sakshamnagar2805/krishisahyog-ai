# Copy to .env.local, configure locally, and NEVER commit real credentials.
# Phase 14: do NOT set NODE_ENV here. Vite applies it to `vite build`; development here produced
# development bundles. `npm run dev` is development automatically; `npm run build` forces production.
DATABASE_URL=postgresql://YOUR_LOCAL_USER:YOUR_PASSWORD@127.0.0.1:5432/krishisahyog
DATABASE_SSL=false
# Only allows LOCALHOST read-only preview of unapproved research notes.
RESEARCH_PREVIEW_ENABLED=false
# Needed ONLY for answers from independently approved source records.
GEMINI_API_KEY=
# gemini-3.8-flash is supported; temperature is omitted automatically for Gemini 3.x+ models.
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Do not set to confirmed unless protected network egress is actually configured.
INGESTION_SECURE_EGRESS=unconfirmed

# Phase 13: ONLY Vite DEV on localhost/127.0.0.1. No production demo data or authority access.
VITE_HACKATHON_DEMO_ENABLED=false
